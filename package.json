{
  "name": "marshgo-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "build:map": "node scripts/with-map-env.mjs vite build",
    "preview:map": "node scripts/with-map-env.mjs vite preview",
    "preview": "vite preview",
    "lint": "npm run lint:all",
    "lint:all": "eslint src scripts shared vite.config.ts eslint.config.js",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check-single-react": "node scripts/check-single-react.mjs",
    "boot-smoke": "node scripts/boot-smoke.mjs",
    "check-tokens": "node scripts/check-tokens.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run check-tokens && npm run build && npm run check:bundle && npm run check-single-react && npm run boot-smoke",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2",
    "@capacitor/status-bar": "^8.0.3",
    "@firebase/app": "0.16.2",
    "@firebase/auth": "1.13.6",
    "lucide-react": "^0.546.0",
    "maplibre-gl": "^6.11.2",
    "motion": "^12.23.24",
    "pmtiles": "^4.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.0"
  }
}
